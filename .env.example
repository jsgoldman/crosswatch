# CrossWatch configuration
# Copy this to .env and fill in your values.

# ── LLM Provider (pick one — needed only for semantic analysis) ──
# If none is set, CrossWatch works as a pure registry without conflict analysis.

# Anthropic (default model: claude-sonnet-4-6)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (default model: gpt-4o)
# OPENAI_API_KEY=sk-...

# Google Gemini (default model: gemini-2.0-flash)
# GOOGLE_API_KEY=...

# ── Optional ─────────────────────────────────────────────────────

# Override the default model for your chosen provider
# CROSSWATCH_MODEL=claude-haiku-4-5-20251001

# Server port (default: 7429)
# CROSSWATCH_PORT=7429

# Engineer identity — auto-detected from git config user.email by hooks.
# Set this to override, e.g. in CI or when git config isn't available.
# CROSSWATCH_ENGINEER_ID=alice@example.com

# Session TTL in milliseconds (default: 7200000 = 2 hours). Set to 0 to disable.
# CROSSWATCH_SESSION_TTL=7200000

# How often to sweep for expired sessions (default: 300000 = 5 minutes)
# CROSSWATCH_SWEEP_INTERVAL=300000
